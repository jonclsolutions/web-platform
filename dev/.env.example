# =============================================================================
# @file .env.example
# @path dev/.env.example
# @project RPSW Web
# @author RPSW
# @created 2026-10-31
# @description Settings of the LOCAL Docker environment (dev/compose.yaml). ./init-workspace.sh
#   copies this file to dev/.env (git-ignored) and fills in COMPOSE_PROJECT_NAME, HOST_UID,
#   HOST_GID and a random DB_ROOT_PASSWORD. Not the Laravel settings - those are in api/.env.
# @note After changing PHP_VERSION / NODE_VERSION / HOST_UID run: ./dev.sh rebuild
# =============================================================================

# Name of this app's containers / volumes (= directory name; keeps cloned apps apart).
COMPOSE_PROJECT_NAME=web-platform

# Your user - files the containers write in the repository belong to it (id -u / id -g).
HOST_UID=1000
HOST_GID=1000

# Versions - keep PHP and MariaDB equal to the hosting (FORPSI offers PHP up to 8.5;
# the database version: phpMyAdmin on the hosting → "Server version").
PHP_VERSION=8.5
NODE_VERSION=24
MARIADB_VERSION=10.11
MAILPIT_VERSION=latest
PHPMYADMIN_VERSION=5.2

# Ports on this computer (published on BIND_IP only). The Angular app calls the API at
# http://127.0.0.1:8000 (erp/src/environments/environment.ts) - change both together.
BIND_IP=127.0.0.1
API_PORT=8000
ERP_PORT=4200
DB_PORT=3307
MAILPIT_PORT=8025
PMA_PORT=8080

# Root password of the LOCAL database container (phpMyAdmin login: root / this password).
DB_ROOT_PASSWORD=
