# Local runtime data of dev.sh / init-workspace (logs, PID files, Windows marker, Docker settings)
/dev/logs/
/dev/pids/
/dev/wsl-workspace
/dev/.env
# Former location of the logs (before 2026-10-31) - the folder can be deleted
/.dev/
/build/
/app_build/
.~lock.*#
tests/unit_tests/**/report/
# Secrets - never commit private keys / certificates (open finding #51)
id_rsa*
id_ed25519*
id_ecdsa*
*.pem
*.key
*.p12
*.pfx
# Local dev certificate of ng serve - generated per developer by init-workspace.sh (finding #54)
/erp/ssl/
temp.txt
# Local scratch files of development (images, media, notes) - created by init-workspace.sh
/temp/
# Former name of the scratch folder (before 2026-10-31) - renamed to temp/ by init-workspace.sh
/.temp/
