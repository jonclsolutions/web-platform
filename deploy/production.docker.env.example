# =============================================================================
# @file production.docker.env.example
# @path deploy/production.docker.env.example
# @project JS web-platform
# @author JS
# @created 2026
# @description Template of /srv/app/.env on a VPS with the Docker stack (deploy/compose.prod.yaml).
#   ONE file holds the settings of the installation: Docker Compose reads it for the stack
#   (images, domain, database container) and passes it to the API containers as their
#   environment (env_file) - Laravel reads the same values as from its .env.
# @usage On the server, as the deploy user (deploy/setup_hosting.md, step 10):
#     cp production.docker.env.example /srv/app/.env && chmod 600 /srv/app/.env && nano /srv/app/.env
#   New secrets:  openssl rand -hex 24   (passwords - only letters and digits, no quoting needed)
#   APP_KEY:      echo "base64:$(openssl rand -base64 32)"
# @security Secrets (APP_KEY, database, SMTP and Turnstile secrets) live ONLY here and in the
#   password manager (Bitwarden) - never in git, GitHub, a chat or an e-mail. Mode 600, owner deploy.
#   APP_KEY never changes after the first start (a different key logs everybody out and makes the
#   encrypted data unreadable).
# @note Values with $, spaces or # go in SINGLE quotes ('pa$$word'): Docker Compose and Laravel
#   then both take them literally. "${APP_NAME}" (double quotes) refers to another value.
# =============================================================================

# ── Stack (Docker Compose) ───────────────────────────────────────────────────
# Images of the release: <IMAGE_PREFIX>-api:<RELEASE> and <IMAGE_PREFIX>-web:<RELEASE>.
# RELEASE is the running release - the deploy script rewrites this line with every release
# (docker compose ps / logs / exec read it from here).
IMAGE_PREFIX=ghcr.io/jonclsolutions/web-platform
RELEASE=
# Domain WITHOUT www (www.<domain> redirects to it) and the address Let's Encrypt writes to.
SITE_DOMAIN=example.com
ACME_EMAIL=sysadmin@example.com
# MariaDB of the stack (container db). DB_ROOT_PASSWORD only for the db container itself.
DB_ROOT_PASSWORD=

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="JS web-platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# https://<SITE_DOMAIN> - the address in e-mails and links (one origin: web, admin and API).
APP_URL=https://example.com
FRONTEND_URL=https://example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Log files in the volume `storage` (storage/logs), 14 days; records also go to the core audit log.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DATABASE_LEVEL=info

# Database = the container db (DB_HOST / DB_PORT are set by compose.yaml). The database and its
# user are created by the db container on the first start - never `root` as DB_USERNAME.
DB_CONNECTION=mysql
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# One origin - no CORS needed.
CORS_ALLOWED_ORIGINS=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── E-mail: FORPSI "E-mail k doméně", mailbox noreply@ ──────────────────────
# smtp.forpsi.com, port 465 with SSL (smtps). Login = the full address + its password.
# Limits of FORPSI: 1 000 e-mails / hour, 20 000 / day; 10 failed logins in an hour block the
# IP of the server for a while - check the password before the first start.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.forpsi.com
MAIL_PORT=465
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Answers to the e-mails of the application go here (Reply-To of every e-mail without its own).
MAIL_REPLY_TO_ADDRESS="info@example.com"
MAIL_REPLY_TO_NAME="${APP_NAME}"

# ── Cloudflare Turnstile (captcha) ───────────────────────────────────────────
# dash.cloudflare.com → Turnstile → widget of SITE_DOMAIN. The SITE key is public (the proxy
# container hands it to the browser at start), the SECRET key stays on the server.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Caddy talks to PHP over FastCGI with the real client IP - no proxy to trust. Set only when a
# proxy (e.g. Cloudflare with the orange cloud) is put in front of the server.
TRUSTED_PROXIES=

# Shop payment simulation - must stay off in production.
SHOP_PAYMENT_SIMULATION=false

# ── Backups (deploy.sh backup, nightly at 02:40) ─────────────────────────────
# /srv/app/backups: database dump + storage/app, kept BACKUP_KEEP_DAYS days (personal data -
# keep it short). BACKUP_REMOTE = folder on the backup server (rsync over SSH with the key
# BACKUP_SSH_KEY of the user deploy); empty = the backups stay only on this VPS.
BACKUP_KEEP_DAYS=14
BACKUP_REMOTE=
BACKUP_SSH_KEY=/home/deploy/.ssh/id_ed25519_backup
