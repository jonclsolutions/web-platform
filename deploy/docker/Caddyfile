# =============================================================================
# @file Caddyfile
# @path deploy/docker/Caddyfile
# @project JS web-platform
# @author JS
# @created 2026
# @description Web server of the production stack (container `proxy`, web.Dockerfile): HTTPS with
#   automatic Let's Encrypt certificates, the Angular app (SPA), /api → php-fpm of the container
#   `app`, the public uploads (/storage) and the security headers; for search engines (2026-11):
#   `/`, `/robots.txt`, `/sitemap.xml` → Laravel (routes/seo.php) and the permanent redirect of
#   the old public addresses without a language to /cs/….
# @note Environment of the container (deploy/compose.prod.yaml, from /srv/app/.env):
#   SITE_DOMAIN  the domain without www (jonclsolutions.com); www.<domain> redirects to it
#   ACME_EMAIL   address Let's Encrypt writes to about the certificates (sysadmin@<domain>)
# @note No access log: it would be a log of IP addresses (personal data) - the app records the
#   security events it needs itself.
# =============================================================================
{
	email {$ACME_EMAIL}
	# Admin API only inside the container, never published.
	admin localhost:2019
}

# Security headers of the SPA, the public web and /storage. The API answers are left out - Laravel
# sets its own, stricter headers (App\Http\Middleware\SecurityHeaders).
# Content-Security-Policy - what the pages may load and run:
#   script-src  own bundle + Cloudflare Turnstile (captcha) + Google Analytics (loaded only after
#               consent); NO inline script and NO eval
#   style-src   'unsafe-inline' is required by Angular (component styles are <style> elements)
#   font-src    the fonts are self-hosted (src/fonts.css)
#   frame-src   only the Turnstile widget; frame-ancestors 'self' = no clickjacking
#   report-uri  every blocked resource is recorded as the security event csp_violation (admin)
# To diagnose a broken page, rename the header to Content-Security-Policy-Report-Only.
(security_headers) {
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://*.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.google-analytics.com https://*.googletagmanager.com; font-src 'self' data:; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests; report-uri /api/csp-report"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		# HTTPS only for one year (no includeSubDomains - other subdomains may have no HTTPS).
		Strict-Transport-Security "max-age=31536000"
	}
}

# www → the domain without www (one address = one cookie origin).
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# The application: one definition for the public site and the internal door below.
(app) {
	encode zstd gzip
	header -Server

	# Request size: uploads up to 25 MB (php: post_max_size) + form fields.
	request_body {
		max_size 26MB
	}

	# Everything below in the written order (route): the refusals first, then the handlers.
	route {
		# Dot files (.env, .git …) are never served, wherever they are; .well-known stays reachable.
		@hidden {
			path_regexp hidden /\.
			not path /.well-known/*
		}
		respond @hidden 404

		# Old public addresses without a language (before 2026-11: /services, /shop/catalog …) → the
		# same page in Czech, the language they were indexed in: a permanent redirect, so search
		# engines move their ranking to the new address. Not: the root (language of the visitor,
		# below), the API, uploads, files, admin / sign-in (no language), the portal and its order
		# form (private links - the frontend adds the visitor's language) and addresses that
		# already start with a language (/cs/…, /en/…, /pt-br/…).
		@legacy {
			not path / /api /api/* /storage/* /admin /admin/* /auth/* /projects/* /order_form/* /.well-known/* /up
			not path_regexp ^/[A-Za-z]{2}(-[A-Za-z]{2,4})?(/|$)
			not path_regexp \.[A-Za-z0-9]+$
		}
		redir @legacy /cs{uri} permanent

		# The bare domain (→ /<language of the visitor>), robots.txt and sitemap.xml are answered by
		# Laravel (routes/seo.php): it knows the active languages and the public pages. No session
		# middleware there, so no cookie.
		@seo path / /robots.txt /sitemap.xml
		handle @seo {
			rewrite * /index.php
			reverse_proxy app:9000 {
				transport fastcgi {
					root /var/www/html/public
					split .php
				}
			}
		}

		# Laravel API → php-fpm of the container `app`. Every /api request runs public/index.php of
		# the app image (the proxy has no PHP files); REQUEST_URI keeps the original path.
		# REMOTE_ADDR is the real client IP (no proxy header to trust).
		@api path /api /api/*
		handle @api {
			rewrite * /index.php
			reverse_proxy app:9000 {
				transport fastcgi {
					root /var/www/html/public
					split .php
				}
			}
		}

		# Public uploads: only storage/app/public of the volume `storage` is mounted (read-only) -
		# the private files, logs and caches are not even visible to this container. No listing.
		# The uploads are data (images, translations), never pages: the stricter CSP below replaces
		# the one of the snippet - a file opened as a document runs no script and gets an opaque
		# origin (sandbox), so even an upload served as HTML / SVG cannot act on the application.
		handle_path /storage/* {
			import security_headers
			header Content-Security-Policy "default-src 'none'; img-src 'self' data:; style-src 'unsafe-inline'; sandbox"
			root * /srv/storage
			file_server
		}

		# Settings of this installation (Turnstile site key) - written at start, never cached.
		handle /runtime-config.js {
			import security_headers
			header Cache-Control "no-store"
			root * /srv/runtime
			file_server
		}

		# Angular: an existing file; a path without a file extension that is no file is a
		# client-side route → index.html. A missing file (/composer.json, /x.php …) is 404.
		handle {
			import security_headers
			root * /srv/www

			# Bundles with a content hash in the name never change → cached for a year.
			@hashed path_regexp hashed -[A-Z0-9]{8}\.(js|css)$
			header @hashed Cache-Control "public, max-age=31536000, immutable"
			# Everything else (index.html, the routes answered by it, translations, images) is
			# revalidated (ETag) → a release is visible at the next page load.
			@unhashed not path_regexp -[A-Z0-9]{8}\.(js|css)$
			header @unhashed Cache-Control "no-cache"

			@route {
				not file
				not path_regexp \.[A-Za-z0-9]+$
			}
			rewrite @route /index.html
			file_server
		}
	}

	# The bare domain must open even while php-fpm is down (deploy, restart): index.html is sent
	# (keeping the error status, so search engines retry later) and the SPA itself then sends the
	# visitor to /<language> (stored choice / browser / English). Every other error keeps the
	# default answer (status without a body).
	handle_errors {
		@root_unavailable {
			path /
			expression `{err.status_code} >= 502 && {err.status_code} <= 504`
		}
		handle @root_unavailable {
			import security_headers
			header Cache-Control "no-cache"
			root * /srv/www
			rewrite * /index.html
			file_server
		}
	}
}

{$SITE_DOMAIN} {
	import app
}

# Internal plain-HTTP door: the same application for the smoke test of deploy/vps/deploy.sh and
# the healthcheck (`wget http://127.0.0.1:8080/…` inside this container) - works before the DNS
# points here and a certificate exists. Bound to 127.0.0.1 of the container, never published.
# Note: `/` is answered by Laravel (redirect to the language) - a check of the proxy alone uses a
# client-side route such as /admin (index.html, no php-fpm).
http://127.0.0.1:8080 {
	bind 127.0.0.1
	import app
}
