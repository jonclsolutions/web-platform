<IfModule mod_rewrite.c>
    RewriteEngine On
    Options -MultiViews -Indexes

    # 0. deny-internal-files: the Laravel folder (.env with secrets, storage with uploads and
    #    logs, vendor, config), the setup script and dot files are never served directly.
    #    Only the original request is checked (REDIRECT_STATUS is empty) - the internal rewrite
    #    of /api to laravel/public/index.php (rule 2) must still pass. REQUEST_URI is already
    #    URL-decoded, so /%6caravel/.env is caught as well.
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_URI} ^/+(laravel|configure-server\.sh)(/|$) [NC,OR]
    RewriteCond %{REQUEST_URI} /\.(?!well-known/) [NC]
    RewriteRule ^ - [F,L]

    # 1. Rule for Storage - if a symlink exists in /www
    RewriteCond %{REQUEST_URI} ^/storage [NC]
    RewriteRule ^storage/(.*)$ storage/$1 [L]

    # 2. Laravel API -> /laravel/public/index.php
    RewriteCond %{REQUEST_URI} ^/api
    RewriteRule ^ laravel/public/index.php [L]

    # 3. If the file or directory exists, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 4. Everything else -> Angular index.html
    RewriteRule ^ index.html [L]
</IfModule>

# Second layer (works even without mod_rewrite): never serve .env / .user.ini / shell scripts.
<FilesMatch "^(\.env.*|\.user\.ini|.*\.sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
